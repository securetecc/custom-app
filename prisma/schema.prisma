generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Vercel's serverless runtime is rhel-openssl-3.0.x. Declaring it
  // explicitly (rather than relying on "native" platform detection at
  // generate time) guarantees that engine binary exists in the build
  // output -- see next.config.ts's outputFileTracingIncludes, which is
  // what then gets it into the deployed function bundle.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connections go through Supabase's TRANSACTION pooler (port 6543)
  // with ?pgbouncer=true&connection_limit=1. Session mode (5432) hands each
  // client a dedicated Postgres connection for its whole session and caps out
  // at 15 -- serverless functions exhaust that almost immediately, surfacing as
  // "FATAL: (EMAXCONNSESSION) max clients reached in session mode".
  url       = env("DATABASE_URL")
  // Migrations and introspection can't run over the transaction pooler
  // (advisory locks / prepared statements), so they use the session pooler.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  technician
}

enum BillingType {
  Hourly
  Retainer
}

enum BillableStatus {
  Billable
  NonBillable
  Residual
}

enum BillingFrequency {
  Monthly
  Annual
}

enum InvoiceStatus {
  Draft
  Sent
  Paid
}

/// Structured category for a recurring charge ("add-on"), replacing a free-text
/// guess at what a charge is for. `Other` covers anything not in the fixed set
/// AddonPricing has a default rate for.
enum AddonItemType {
  DMARC
  MonitoringSeat
  RemoteMonitoring
  Other
}

/// Where a TimeEntry originated -- purely provenance/audit, never affects
/// billing logic. Manual is the default so existing rows need no backfill.
enum TimeEntrySource {
  Manual
  Voice
  CsvImport
}

/// Five tiers, matching the v1 client portal's published response-time SLAs:
/// Emergency 1h, Critical 4h, High 8h, Medium 24h, Low 48h (business hours).
enum TicketUrgency {
  Emergency
  Critical
  High
  Medium
  Low
}

enum TicketStatus {
  New
  InProgress
  Resolved
  Closed
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  logoUrl             String?
  brandColorPrimary   String   @default("#071E37")
  brandColorAccent    String   @default("#06E1DC")
  /// The REAL, monitored inbox. Two distinct jobs, both of which need a human
  /// reading them: it's the `to:` for internal new-ticket alerts, and the
  /// `replyTo:` on client-facing mail. Deliberately NOT the `from:` — see
  /// notificationFromEmail.
  supportEmail        String   @unique
  /// The `from:` for automated Resend mail (ticket confirmations, status
  /// changes, digests). Split out from supportEmail because outbound sending
  /// moved to a dedicated subdomain (noreply@alerts.securetecc.com) so its SPF
  /// record stays independent of the root domain's Google Workspace one.
  /// A noreply sender must never be the to:/replyTo: — that black-holes both
  /// internal alerts and client replies. Falls back to supportEmail when unset.
  notificationFromEmail String?
  // From address used specifically for outbound invoice emails (may differ
  // from supportEmail — e.g. a named staff mailbox rather than a shared inbox).
  invoiceFromEmail    String?
  phone               String?
  // Manual onboarding checklist flag: domain/DKIM verified in Resend.
  // Sends are blocked until this is true — see lib/email.
  emailDomainVerified Boolean  @default(false)
  /// Monthly invoicing target the dashboard meter reads against. A business
  /// number, so it lives in the DB and is editable in Settings → Organization
  /// rather than being a constant someone has to redeploy to change.
  monthlyRevenueGoal  Decimal  @default(20000) @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  // --- Invoice letterhead -------------------------------------------------
  // The invoice PDF's letterhead names an individual biller (e.g. the owner),
  // not the org itself -- distinct from `name` above. `phone` (below the
  // relations) doubles as the letterhead's "Office:" line; these are the
  // fields with no existing equivalent. All optional: invoices just render
  // the corresponding line blank until Settings → Organization is filled in.
  billerName             String?
  billerAddress1         String?
  billerAddress2         String?
  billerCityStateZip     String?
  billerMobilePhone      String?
  billerEmail            String?
  website                String?
  // Invoice PDF's "FOR:" row. Falls back to "IT Services" at render time when null.
  invoiceForLabel        String?
  checkPayableTo         String?
  acceptedPaymentMethods String?
  // Per-org ticket counter, incremented atomically alongside ticket creation
  // to produce TKT-0001 (same approach as Client.lastInvoiceSequence).
  // Phase 6 note: the Sheets migration must seed this to the highest existing
  // ticket number, NOT leave it at 0.
  lastTicketSequence  Int      @default(0)

  users                  User[]
  clients                Client[]
  serviceTypes           ServiceType[]
  timeEntries            TimeEntry[]
  reimbursableExpenses   ReimbursableExpense[]
  recurringCharges       RecurringCharge[]
  recurringChargeAuditLogs RecurringChargeAuditLog[]
  addonPricing           AddonPricing[]
  invoiceRecurringCharges InvoiceRecurringCharge[]
  invoiceRetainerPeriods  InvoiceRetainerPeriod[]
  invoices               Invoice[]
  tickets                Ticket[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Mirrors Supabase auth.users.id — this row is the app-side profile/role record.
  authUserId     String       @unique
  name           String
  email          String
  role           UserRole     @default(technician)
  /// Whether the 7pm Pacific "you haven't logged time today" nag goes to this
  /// person. Off by default and deliberately per-user rather than sent to
  /// every staff row: it's addressed to whoever actually logs billable hours,
  /// and mailing it to people who don't just trains them to ignore it.
  receivesDailyReminder Boolean @default(false)
  /// Storage path in the private "avatars" bucket, not a URL -- the bucket is
  /// private, so what's shown is a short-lived signed URL minted per request.
  avatarPath     String?
  /// Birthday as month/day integers rather than a Date. Only the day matters
  /// for a greeting, and storing a timestamp would mean a date-only value
  /// crossing timezones -- the exact bug that shifted the digest window and
  /// every imported time entry. Ints cannot drift. The year is deliberately
  /// not collected: it isn't needed and it's the sensitive half.
  birthMonth     Int?
  birthDay       Int?
  createdAt      DateTime     @default(now())

  loggedTimeEntries          TimeEntry[]            @relation("LoggedByUser")
  loggedReimbursableExpenses ReimbursableExpense[]
  assignedTickets            Ticket[]               @relation("AssignedToUser")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  shortName      String
  contactName    String?
  email          String?
  phone          String?
  address1       String?
  address2       String?
  cityStateZip   String?
  /// Human-readable id carried over from the Operations Master Sheet
  /// ("CLI-016"). Distinct from `id` (a uuid) and from `shortName` (the
  /// invoice-number prefix) -- this exists so rows can be reconciled against
  /// the spreadsheet by eye. Null for clients the sheet never numbered.
  reference      String?
  billingType    BillingType  @default(Hourly)
  billingRate    Decimal?     @db.Decimal(10, 2)
  activeStatus   Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  // Per-client invoice counter, incremented atomically inside the same
  // transaction that creates an Invoice (see invoices/actions.ts) to produce
  // {shortName}-{00001}. Never decremented -- a voided invoice keeps its
  // number, matching normal accounting practice.
  // Phase 6 note: the Sheets migration must seed this to each client's
  // highest existing invoice number, NOT leave it at 0.
  lastInvoiceSequence Int     @default(0)

  timeEntries          TimeEntry[]
  reimbursableExpenses ReimbursableExpense[]
  recurringCharges     RecurringCharge[]
  invoices             Invoice[]
  retainerPeriods      InvoiceRetainerPeriod[]

  @@unique([organizationId, shortName])
  @@unique([organizationId, reference])
  @@index([organizationId])
  @@map("clients")
}

model ServiceType {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  label               String
  billingMinimumHours Decimal      @db.Decimal(5, 2)
  // Overrides the client's standard billingRate when set (e.g. Low Voltage).
  rateOverride        Decimal?     @db.Decimal(10, 2)

  timeEntries TimeEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("service_types")
}

model TimeEntry {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime       @db.Date
  durationHours  Decimal        @db.Decimal(5, 2)
  description    String
  billableStatus BillableStatus @default(Billable)
  serviceTypeId  String
  serviceType    ServiceType    @relation(fields: [serviceTypeId], references: [id])
  // Null while unbilled; set once included on a generated invoice.
  invoiceId      String?
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  loggedByUserId String
  loggedByUser   User           @relation("LoggedByUser", fields: [loggedByUserId], references: [id])
  // Original voice/text input, kept only when this entry came from the AI parser.
  rawInput       String?
  // Provenance only -- never affects billing/rate logic. Defaults to Manual so
  // every pre-existing row needs no backfill.
  source         TimeEntrySource @default(Manual)
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceId])
  @@map("time_entries")
}

/// A one-off billable material/expense cost (e.g. a replacement part), distinct
/// from TimeEntry (labor). Shaped identically to TimeEntry's billing lifecycle:
/// invoiceId is null while unbilled, set once included on a generated invoice,
/// and cleared again if that invoice is voided (see invoices/actions.ts).
model ReimbursableExpense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  description    String
  amount         Decimal      @db.Decimal(10, 2)
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  loggedByUserId String
  loggedByUser   User         @relation(fields: [loggedByUserId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceId])
  @@map("reimbursable_expenses")
}

/// A perpetual billing template (e.g. "Managed Antivirus -- $50/mo"), NOT a
/// one-time event like TimeEntry. It must stay billable every period, so it
/// deliberately carries no invoiceId: "was this already billed for period X?"
/// is answered by InvoiceRecurringCharge instead. Retire one with
/// activeStatus rather than deleting, so historical snapshots keep their FK.
model RecurringCharge {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// "RC-001" from the master sheet; assigned sequentially for new charges.
  reference        String?
  description      String
  amount           Decimal          @db.Decimal(10, 2)
  /// Free-text context ("18 devices x $25 -- verify count monthly"). Kept on
  /// the charge itself, not only in the audit log, because it's operational
  /// detail someone needs while looking at the charge.
  notes            String?
  billingFrequency BillingFrequency @default(Monthly)
  activeStatus     Boolean          @default(true)
  // Structured category + who signed off on it. Both optional -- older/plain
  // retainer-style charges never need to classify themselves. itemType, when
  // set, is used only to pre-fill a suggested amount from AddonPricing in the
  // UI; it never affects billing.
  itemType         AddonItemType?
  authorizedBy     String?
  createdAt        DateTime         @default(now())

  invoiceOccurrences InvoiceRecurringCharge[]
  auditLog           RecurringChargeAuditLog[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([clientId])
  @@map("recurring_charges")
}

/// Append-only history of every create/update to a RecurringCharge, snapshotting
/// who authorized it and what changed. Rows are inserted alongside the
/// RecurringCharge write in the same transaction and are never updated or
/// deleted by application code (see recurring-charge-actions.ts) -- the RLS
/// migration backs this with no update/delete policy at all.
model RecurringChargeAuditLog {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recurringChargeId String
  recurringCharge   RecurringCharge  @relation(fields: [recurringChargeId], references: [id], onDelete: Cascade)
  action            String           // "created" | "updated"
  itemType          AddonItemType?
  description       String
  amount            Decimal          @db.Decimal(10, 2)
  billingFrequency  BillingFrequency
  authorizedBy      String
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([organizationId])
  @@index([recurringChargeId])
  @@map("recurring_charge_audit_log")
}

/// Reference-only default rate per add-on item type, used purely to pre-fill
/// the amount field in the UI when an item type is chosen -- never enforced or
/// read by billing logic (a technician can always override the amount).
model AddonPricing {
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemType       AddonItemType
  defaultRate    Decimal       @db.Decimal(10, 2)

  @@id([organizationId, itemType])
  @@map("addon_pricing")
}

/// One row per "this recurring charge was billed on this invoice", with the
/// description/amount/frequency snapshotted at billing time so a later edit to
/// the template never retroactively rewrites what a past invoice claimed.
/// Rows are immutable: inserted during generation, deleted when an invoice is
/// voided (which correctly re-opens that charge for that period).
model InvoiceRecurringCharge {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recurringChargeId String
  recurringCharge   RecurringCharge  @relation(fields: [recurringChargeId], references: [id])
  description       String
  amount            Decimal          @db.Decimal(10, 2)
  billingFrequency  BillingFrequency
  // The specific calendar month (Monthly) or January (Annual) this row
  // covers -- distinct from the parent Invoice's own periodStart/periodEnd,
  // which can now span many months. "Already billed?" is checked against
  // THIS range, not the invoice's, so a charge can't be double-billed by
  // mixing single-month and multi-month invoice generations for overlapping
  // months. Backfilled from the parent invoice's period for rows that
  // predate multi-month invoicing (always single-month, so it's exact).
  periodStart       DateTime         @db.Date
  periodEnd         DateTime         @db.Date
  createdAt         DateTime         @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@index([recurringChargeId])
  @@map("invoice_recurring_charges")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Format: {ClientShortName}-{00001}, 5-digit zero-padded, sequential per client.
  invoiceNumber  String
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  totalHours     Decimal       @db.Decimal(7, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(Draft)
  // Storage object path in the private `invoices` bucket (NOT a public URL) --
  // the app mints a short-lived signed URL on demand. Null until the PDF is
  // rendered, which happens after the generation transaction commits.
  pdfUrl         String?
  // Status alone can't answer "when was this sent?" once it moves to Paid,
  // and both dates are shown on the list/detail screens.
  /// Set when the invoice came from the Operations Master Sheet rather than
  /// being generated here -- holds the sheet's own identifier.
  ///
  /// Two jobs. It makes an import precisely reversible (delete exactly these
  /// rows, nothing else), and it distinguishes "no PDF because the original
  /// lives in Drive" from "no PDF because rendering failed", which are the
  /// same null pdfUrl but opposite situations for the person looking at it.
  importedFrom   String?
  /// Gmail draft this invoice was written into, so a second click updates
  /// that draft instead of leaving a pile of identical ones in the mailbox.
  /// Cleared when the invoice is voided.
  gmailDraftId   String?
  sentAt         DateTime?
  paidAt         DateTime?
  // Set when the invoice is voided/deleted instead of hard-deleting the row,
  // so archived PDFs and invoice-number history stay intact.
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())

  timeEntries          TimeEntry[]
  reimbursableExpenses ReimbursableExpense[]
  recurringCharges     InvoiceRecurringCharge[]
  retainerPeriods      InvoiceRetainerPeriod[]
  customItems          InvoiceCustomItem[]

  @@unique([organizationId, clientId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@map("invoices")
}

/// One row per "this client's flat retainer was billed for this calendar
/// month". Retainer clients pay a flat rate per month regardless of hours, so
/// without a ledger two invoices whose periods both touch March would each
/// charge March's retainer -- the exact double-billing InvoiceRecurringCharge
/// prevents for recurring charges. Same shape and same rules: the amount is
/// snapshotted at billing time so a later change to Client.billingRate never
/// rewrites history, and rows are deleted when an invoice is voided, which
/// correctly re-opens that month.
/// A line added to an invoice by hand, rather than derived from a time entry,
/// expense or recurring charge.
///
/// Exists because those three sources can't express everything that ends up on
/// a real invoice -- a one-off adjustment, a credit, a discount, work agreed
/// verbally. Editing the derived lines instead would mean rewriting the
/// underlying records, which are shared with reporting and other invoices.
model InvoiceCustomItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Optional so a credit or note can carry no date, matching how charge rows render.
  date        DateTime? @db.Date
  description String
  /// Both nullable: a flat adjustment has no hours or rate, only an amount.
  hours       Decimal? @db.Decimal(7, 2)
  rate        Decimal? @db.Decimal(10, 2)
  /// Signed on purpose -- a negative amount is how a discount or credit is expressed.
  amount      Decimal  @db.Decimal(10, 2)
  /// Keeps hand-added lines in the order they were entered.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_custom_items")
}

model InvoiceRetainerPeriod {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// First/last day of the calendar month this row covers.
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  /// Client.billingRate as it was when billed.
  amount         Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceId])
  @@map("invoice_retainer_periods")
}

model Ticket {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Format: TKT-0001, sequential per organization.
  ticketNumber      String
  clientCompanyName String
  contactName       String
  contactEmail      String
  /// Best number to reach the submitter -- carried over from the v1 portal,
  /// where urgent issues are often faster to resolve by phone than by email.
  callbackNumber    String?
  issueType         String
  urgency           TicketUrgency @default(Medium)
  description       String
  status            TicketStatus  @default(New)
  assignedToUserId  String?
  assignedToUser    User?         @relation("AssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  internalNotes     String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())

  attachments TicketAttachment[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([status])
  @@map("tickets")
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Supabase Storage path: org/{orgId}/{clientCompanyName}/{ticketNumber}/{fileName}
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// DB-backed fixed-window rate limiter for the two public, unauthenticated
/// actions (ticket submission, ticket status lookup) -- an in-memory counter
/// wouldn't survive across serverless invocations, so the counter itself has
/// to live somewhere durable. Not tenant data and never touched through
/// withRLS: see src/lib/rate-limit.ts, which uses the trusted Prisma client
/// directly (same category as the ticket-sequence increment).
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limit_hits")
}

/// One row per scheduled job per occurrence it has already handled.
///
/// Exists because the cron design fires each job at BOTH candidate UTC hours
/// (the PST and PDT offsets) and lets a Pacific-local gate pick the right one.
/// That's correct for DST but brittle for failure: when the primary firing was
/// missed -- a deployment landed in the same second on 2026-08-24 -- the
/// backup hour was gated out for being an hour late, and the week's digest was
/// simply lost with nothing reporting it.
///
/// The unique constraint IS the lock. A firing claims its occurrence by
/// inserting; a duplicate insert fails, which is how the second candidate hour
/// discovers the first already ran. No read-then-write race.
model CronRun {
  id        String   @id @default(uuid())
  /// Route name, e.g. "weekly-digest".
  jobName   String
  /// The Pacific date the occurrence belongs to (YYYY-MM-DD). Sufficient for
  /// all four jobs: the schedule already pins weekly runs to a weekday and
  /// monthly ones to the 1st, so the date alone identifies the occurrence.
  periodKey String
  ranAt     DateTime @default(now())

  @@unique([jobName, periodKey])
  @@map("cron_runs")
}
