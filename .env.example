# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Service role key: server-only, never exposed to the client. Used for tenant
# onboarding (creating orgs/staff users) and other admin-level operations that
# must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Prisma connects directly to the Supabase Postgres instance (use the
# "Session" pooler connection string, port 6543, with pgbouncer=true, for
# serverless; or the direct connection for local dev/migrations).
# Runtime connections. With Supabase use the TRANSACTION pooler (port 6543)
# plus ?pgbouncer=true&connection_limit=1 -- the session pooler (5432) caps at
# 15 clients and serverless functions exhaust it ("EMAXCONNSESSION").
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations/seeding. With Supabase use the SESSION pooler (port 5432); these
# can't run over the transaction pooler. Locally this can equal DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Google Gemini API key for AI-assisted time entry parsing.
GEMINI_API_KEY="xxxxx"

# Resend API key for transactional email.
RESEND_API_KEY="xxxxx"

# Base URL of this app, used in email CTAs and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
