# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Service role key: server-only, never exposed to the client. Used for tenant
# onboarding (creating orgs/staff users) and other admin-level operations that
# must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Runtime connections. With Supabase use the TRANSACTION pooler (port 6543)
# plus ?pgbouncer=true -- the SESSION pooler (5432) hands out a dedicated
# Postgres connection per client and caps at 15, which serverless exhausts
# ("EMAXCONNSESSION"). connection_limit is 5 rather than the usual serverless
# 1 because withRLS() wraps every query in an interactive transaction, so a
# single connection serializes concurrent requests into P2028 timeouts.
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations/seeding. With Supabase use the SESSION pooler (port 5432); these
# can't run over the transaction pooler. Locally this can equal DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Google Gemini API key for AI-assisted time entry parsing.
GEMINI_API_KEY="xxxxx"

# Resend API key for transactional email.
RESEND_API_KEY="xxxxx"

# Safe mode. Set to 1 and the app touches nothing outside its own database:
# no email sends, no Gmail drafts, no Drive uploads. Use during data
# migration and when testing against real records.
SAFE_MODE=""

# Test mode. Set this to an address and EVERY outbound email goes there
# instead of its real recipient, with a banner naming who it was meant for.
# Leave BLANK in production -- a value here means clients hear nothing.
EMAIL_REDIRECT_TO=""

# Base URL of this app, used in email CTAs and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the scheduled jobs in vercel.json. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. The /api/cron/* routes fail CLOSED when
# it's unset, so they stay disabled rather than world-callable.
CRON_SECRET="generate-a-long-random-string"

# --- Google Workspace (invoice Gmail drafts) --------------------------------
# Invoices are NOT auto-sent: the app creates a draft in Tony's Workspace
# mailbox with the PDF attached, he reviews and sends it, then clicks
# "Mark as sent" in the app. Ticket/digest email still goes via Resend.
# Setup instructions: docs/google-setup.md
# Service account created in Google Cloud, granted domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_EMAIL="invoice-drafter@your-project.iam.gserviceaccount.com"
# The PEM private key from the service account's JSON key file. Newlines must
# be escaped as \n -- the code unescapes them at read time.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# The Workspace user the service account acts as. Drafts appear in THIS mailbox.
GOOGLE_IMPERSONATED_USER="tgregory@securetecc.com"
# Optional: anchor Drive archiving to an EXISTING "SecureTECC Master" folder by
# id (from its URL) instead of matching on name. Omit to match/create by name.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_INVOICE_TEMPLATE_ID=""

# Public client-facing ticket portal (ticket.securetecc.com). Separate from
# NEXT_PUBLIC_APP_URL, which is the staff app (manage.securetecc.com) --
# client email must never link into manage.*, where they'd hit a login page.
# Used for the "check the status of this request" link in the ticket
# confirmation email; the link is omitted entirely if this is unset.
NEXT_PUBLIC_TICKET_PORTAL_URL="https://ticket.securetecc.com"
SENTRY_DSN="xxxxx"
NEXT_PUBLIC_SENTRY_DSN="xxxxx"
SENTRY_AUTH_TOKEN="xxxxx"
