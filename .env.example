# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Service role key: server-only, never exposed to the client. Used for tenant
# onboarding (creating orgs/staff users) and other admin-level operations that
# must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Runtime connections. With Supabase use the TRANSACTION pooler (port 6543)
# plus ?pgbouncer=true -- the SESSION pooler (5432) hands out a dedicated
# Postgres connection per client and caps at 15, which serverless exhausts
# ("EMAXCONNSESSION"). connection_limit is 5 rather than the usual serverless
# 1 because withRLS() wraps every query in an interactive transaction, so a
# single connection serializes concurrent requests into P2028 timeouts.
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations/seeding. With Supabase use the SESSION pooler (port 5432); these
# can't run over the transaction pooler. Locally this can equal DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Google Gemini API key for AI-assisted time entry parsing.
GEMINI_API_KEY="xxxxx"

# Resend API key for transactional email.
RESEND_API_KEY="xxxxx"

# Base URL of this app, used in email CTAs and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the scheduled jobs in vercel.json. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. The /api/cron/* routes fail CLOSED when
# it's unset, so they stay disabled rather than world-callable.
CRON_SECRET="generate-a-long-random-string"
